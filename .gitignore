frps*.ini
frps*.json
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm
*.har
browser-profile/
chrome-profile/
playwright/.auth/
stronghold-stats-*.json
stronghold-loadout-*.json
stronghold-ownership-*.json
stronghold-diy-*.json
# Reviewed templates may be tracked; they must contain placeholders only.
!.env.example
!.env.*.example

